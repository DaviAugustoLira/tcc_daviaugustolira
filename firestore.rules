rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Spike descartável (ver CLAUDE.md secao 5/9) — só prova que o app fala com o Firestore
    // nas duas plataformas. Não faz parte do schema real do TCC (maps, points, beacons,
    // historyCalibration, administrators, logs) e não deve virar padrão.
    match /healthcheck/{docId} {
      allow read, write: if true;
    }

    // Feature 1 (admin-auth-shell): stub restritivo — só distingue autenticado de
    // não autenticado (RNF04). Custom claims/role e o restante do schema de
    // `administrators` (cadastro, permissões) ficam para a Feature 6/7.
    match /administrators/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Painel admin lista os maps existentes (change admin-auth-shell). Sem custom
    // claims ainda, então qualquer admin autenticado lê todos os maps — filtro por
    // permissão fica para quando a Feature 6/7 trouxer roles. Edição de mapa é
    // fora de escopo aqui.
    match /maps/{mapId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Schema real fica fechado até cada coleção ganhar suas próprias regras (skill
    // firestore-collection) — nunca abrir por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
